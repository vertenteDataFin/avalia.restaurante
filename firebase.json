{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "app-mob-alimento-2026",
          "appId": "1:719186430318:android:86b56255fbead669d1197f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "app-mob-alimento-2026",
          "configurations": {
            "android": "1:719186430318:android:86b56255fbead669d1197f",
            "web": "1:719186430318:web:5f7b63d6c0a7ff1ad1197f"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "avalia-restaurante-vertente",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}